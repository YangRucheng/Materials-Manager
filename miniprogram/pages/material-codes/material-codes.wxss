.material-codes-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-header { margin: 4rpx 4rpx 24rpx; }
.list-header .page-title { font-size: 44rpx; }

.list-tools {
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.result-count { margin: 0 8rpx 14rpx; color: #7d8798; font-size: 23rpx; }
.code-list { display: flex; flex-direction: column; gap: 16rpx; }

.code-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #eef1f6;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.code-value {
  flex: none;
  max-width: 55%;
  overflow: hidden;
  color: #2b4fc4;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #172033;
  font-size: 26rpx;
  font-weight: 550;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.code-unit {
  flex: none;
  overflow: hidden;
  color: #8a94a5;
  font-size: 24rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-panel { display: flex; min-height: 420rpx; align-items: center; justify-content: center; }
.empty-panel { box-sizing: border-box; padding-top: 40rpx; }
.load-more, .load-finished { padding: 28rpx 0 8rpx; color: #a1a9b7; font-size: 22rpx; text-align: center; }

.back-top-fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #3f63d8;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.35);
  line-height: 1;
}

.back-top-fab::after {
  border: 0;
}
