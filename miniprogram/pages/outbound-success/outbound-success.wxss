.success-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.success-result {
  margin: 8rpx 0 28rpx;
}

.material-card {
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #2947a6, #5579e7);
  box-shadow: 0 18rpx 44rpx rgba(41, 71, 166, 0.2);
  color: #ffffff;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.material-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.material-spec {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.stock-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
}

.stock-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.quantity-value {
  margin-top: 4rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.quantity-unit {
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 550;
  color: rgba(255, 255, 255, 0.82);
}

.after-block {
  text-align: right;
}

.after-value {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.2;
}

.detail-card .section-heading {
  padding: 18rpx 22rpx;
}

.detail-card .section-divider {
  margin: 0 22rpx;
}

.detail-list {
  padding: 4rpx 22rpx 10rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 17rpx 0;
  border-bottom: 2rpx solid #edf0f5;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  flex: none;
  width: 160rpx;
  color: #8a94a5;
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: #30394a;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.success-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.success-action {
  flex: 1;
  min-width: 0;
}

.finish-action {
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-primary-active-bg-color: #3151bd;
  --td-button-primary-active-border-color: #3151bd;
  --td-button-border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.2);
}
