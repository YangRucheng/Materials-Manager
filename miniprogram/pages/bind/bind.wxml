<view class="page-shell profile-page">
  <view class="brand-panel">
    <view class="brand-orbit brand-orbit-large"></view>
    <view class="brand-orbit brand-orbit-small"></view>
    <view class="brand-content">
      <view class="brand-eyebrow">ELECTRICAL WORKSHOP</view>
      <view class="brand-title">{{i18n.electricalWorkshopParts}}</view>
    </view>
  </view>

  <view class="page-header profile-header">
    <view class="page-eyebrow">{{i18n.firstUse}}</view>
    <view class="page-title">{{i18n.setUser}}</view>
  </view>

  <view class="section-card profile-card">
    <view class="section-heading">
      <view class="section-title">{{i18n.identityInfo}}</view>
    </view>
    <view class="section-divider"></view>
    <t-cell-group>
      <t-input
        label="{{i18n.name}}"
        placeholder="{{i18n.realNamePlaceholder}}"
        maxlength="64"
        value="{{displayName}}"
        bind:change="onNameChange"
      />
      <t-input
        label="{{i18n.department}}"
        placeholder="{{i18n.departmentPlaceholder}}"
        maxlength="128"
        value="{{departmentName}}"
        bind:change="onDepartmentChange"
      />
    </t-cell-group>
  </view>
  <t-button
    class="primary-action"
    theme="primary"
    size="large"
    block
    loading="{{loading}}"
    disabled="{{loading}}"
    bind:tap="submitProfile"
  >{{i18n.enterOutbound}}</t-button>
  <view class="binding-warning">{{i18n.bindingWarning}}</view>
  <t-toast id="profile-toast" />
</view>
