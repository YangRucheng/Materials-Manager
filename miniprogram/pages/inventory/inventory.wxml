<view class="page-shell inventory-page">
  <view class="inventory-header">
    <view class="page-title">{{i18n.inventoryTitle}}</view>
  </view>

  <view class="inventory-tools">
    <t-search
      value="{{keyword}}"
      placeholder="{{i18n.searchPlaceholder}}"
      shape="round"
      confirm-type="search"
      bind:change="onSearchChange"
    />
    <t-tabs
      value="{{stockStatus}}"
      theme="tag"
      split="{{false}}"
      show-bottom-line="{{false}}"
      bind:change="onStatusChange"
    >
      <t-tab-panel value="all" label="{{i18n.all}}" />
      <t-tab-panel value="out_of_stock" label="{{i18n.outOfStock}}" />
      <t-tab-panel value="low_stock" label="{{i18n.lowStock}}" />
    </t-tabs>
  </view>

  <view wx:if="{{!loading || items.length}}" class="result-count">{{resultCount}}</view>

  <view wx:if="{{loading && !items.length}}" class="state-panel">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingInventory}}" />
  </view>

  <view wx:elif="{{!items.length}}" class="state-panel empty-panel">
    <t-empty icon="search" description="{{i18n.inventoryEmpty}}" />
  </view>

  <view wx:else class="inventory-list">
    <view
      wx:for="{{items}}"
      wx:key="uuid"
      class="inventory-card"
      hover-class="inventory-card-active"
      data-uuid="{{item.uuid}}"
      bind:tap="openDetail"
    >
      <view class="card-heading">
        <view class="material-name">{{item.name}}</view>
        <t-tag theme="{{item.stock_status_theme}}" variant="light" size="small">
          {{item.stock_status_label}}
        </t-tag>
      </view>
      <view class="material-spec">
        <text class="spec-label">{{i18n.modelSpec}}</text>
        <text>{{item.model_spec}}</text>
      </view>
      <view class="card-divider"></view>
      <view class="inventory-meta">
        <view class="meta-item">
          <view class="meta-label">{{i18n.stockQuantity}}</view>
          <view class="stock-quantity">{{item.current_qty}}</view>
        </view>
        <view class="meta-item unit-item">
          <view class="meta-label">{{i18n.unit}}</view>
          <view class="meta-value">{{item.unit_name}}</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#a1a9b7" />
      </view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="load-more">
    <t-loading theme="circular" size="36rpx" text="{{i18n.loadMore}}" />
  </view>
  <view wx:elif="{{items.length && !hasMore}}" class="load-finished">{{i18n.noMore}}</view>
  <t-toast id="inventory-toast" />
</view>
