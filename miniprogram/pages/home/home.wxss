.home-page {
  padding: 28rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin: 4rpx 4rpx 28rpx;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 300rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid #dce5ff;
  border-radius: 999rpx;
  background: #edf2ff;
}

.operator-badge-active,
.action-card-active {
  transform: scale(0.98);
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3f63d8;
  box-shadow: 0 0 0 6rpx rgba(63, 99, 216, 0.12);
}

.operator-name {
  overflow: hidden;
  color: #3658c7;
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.action-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 16rpx;
  border: 2rpx solid #dce5ff;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #edf2ff 100%);
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.08);
  transition: transform 120ms ease;
}

.action-icon {
  display: flex;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #3f63d8;
  color: #ffffff;
}

.action-content {
  flex: 1;
  min-width: 0;
}

.action-title {
  overflow: hidden;
  color: #243765;
  font-size: 26rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.action-description {
  margin-top: 4rpx;
  overflow: hidden;
  color: #7180a5;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
}

.scan-description {
  margin-top: 6rpx;
  color: #7180a5;
  font-size: 23rpx;
}

.scan-card {
  box-sizing: border-box;
  padding: 42rpx 32rpx 34rpx;
  border-color: #dce5ff;
  text-align: center;
  background: linear-gradient(145deg, #ffffff 0%, #f8faff 100%);
}

.scan-icon {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 34rpx;
  background: #edf2ff;
  color: #3f63d8;
}

.scan-title {
  margin-top: 24rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 650;
}

.scan-action {
  margin-top: 32rpx;
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-border-radius: 18rpx;
}

.user-profile-popup {
  box-sizing: border-box;
  width: 620rpx;
  padding: 42rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.user-profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  background: #edf2ff;
  color: #3f63d8;
}

.user-profile-title {
  margin: 18rpx 0 26rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

.user-profile-list {
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  background: #f8faff;
}

.user-profile-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #e9edf5;
}

.user-profile-row:last-child {
  border-bottom: 0;
}

.user-profile-label {
  flex: none;
  width: 120rpx;
  color: #8a94a5;
  font-size: 23rpx;
}

.user-profile-value {
  flex: 1;
  color: #30394a;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.user-profile-records {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 2rpx solid #e5ebf7;
  border-radius: 20rpx;
  background: #f8faff;
  transition: background 120ms ease;
}

.user-profile-records-active {
  background: #eef2ff;
}

.records-entry {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.records-entry-text {
  color: #3658c7;
  font-size: 26rpx;
  font-weight: 550;
}

.share-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #3f63d8;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.35);
  line-height: 1;
}

.share-fab::after {
  border: 0;
}

