<view class="page-shell home-page">
  <view class="page-header">
    <view class="header-row">
      <view class="page-title">{{i18n.appTitle}}</view>
      <view wx:if="{{user}}" class="operator-badge" hover-class="operator-badge-active" bind:tap="showUserProfile">
        <view class="operator-dot"></view>
        <view class="operator-name">{{user.display_name}}</view>
        <t-icon name="chevron-down" size="24rpx" color="#5573d1" />
      </view>
    </view>
  </view>

  <view class="action-grid">
    <view class="action-card" hover-class="action-card-active" bind:tap="openInventory">
      <view class="action-icon"><t-icon name="view-list" size="48rpx" /></view>
      <view class="action-content">
        <view class="action-title">{{i18n.allInventory}}</view>
        <view class="action-description">{{i18n.inventoryDescription}}</view>
      </view>
    </view>

    <view class="action-card" hover-class="action-card-active" bind:tap="openPurchasePlans">
      <view class="action-icon"><t-icon name="file-attachment" size="48rpx" /></view>
      <view class="action-content">
        <view class="action-title">{{i18n.purchasePlans}}</view>
        <view class="action-description">{{i18n.purchasePlansDescription}}</view>
      </view>
    </view>

    <view class="action-card" hover-class="action-card-active" bind:tap="openPurchaseRecords">
      <view class="action-icon"><t-icon name="file-copy" size="48rpx" /></view>
      <view class="action-content">
        <view class="action-title">{{i18n.purchaseRecordsTitle}}</view>
        <view class="action-description">{{i18n.purchaseRecordsDescription}}</view>
      </view>
    </view>

    <view class="action-card" hover-class="action-card-active" bind:tap="openMaterialCodes">
      <view class="action-icon"><t-icon name="tag" size="48rpx" /></view>
      <view class="action-content">
        <view class="action-title">{{i18n.materialCodesTitle}}</view>
        <view class="action-description">{{i18n.materialCodesDescription}}</view>
      </view>
    </view>
  </view>

  <view class="section-card scan-card">
    <view class="scan-icon"><t-icon name="scan" size="64rpx" /></view>
    <view class="scan-title">{{i18n.scanMaterialCode}}</view>
    <view class="scan-description">{{i18n.scanDescription}}</view>
    <t-button
      class="scan-action"
      theme="primary"
      size="large"
      block
      loading="{{scanning}}"
      disabled="{{scanning}}"
      icon="scan"
      bind:tap="scanMaterial"
    >{{i18n.startScan}}</t-button>
  </view>

  <t-toast id="home-toast" />
  <t-popup
    visible="{{userProfileVisible}}"
    placement="center"
    close-btn
    close-on-overlay-click
    bind:visible-change="onUserProfileVisibleChange"
  >
    <view class="user-profile-popup">
      <view class="user-profile-avatar"><t-icon name="user" size="48rpx" /></view>
      <view class="user-profile-title">{{i18n.personalInfo}}</view>
      <view class="user-profile-list">
        <view class="user-profile-row">
          <view class="user-profile-label">{{i18n.name}}</view>
          <view class="user-profile-value">{{user.display_name}}</view>
        </view>
        <view class="user-profile-row">
          <view class="user-profile-label">{{i18n.department}}</view>
          <view class="user-profile-value">{{user.department_name}}</view>
        </view>
        <view class="user-profile-row">
          <view class="user-profile-label">{{i18n.registeredAt}}</view>
          <view class="user-profile-value">{{user.registered_at}}</view>
        </view>
        <view class="user-profile-row">
          <view class="user-profile-label">{{i18n.miniProgramUpdatedAt}}</view>
          <view class="user-profile-value">{{miniProgramUpdatedAt}}</view>
        </view>
      </view>
      <view class="user-profile-records" hover-class="user-profile-records-active" bind:tap="openRecords">
        <view class="records-entry">
          <t-icon name="time" size="36rpx" color="#5573d1" />
          <view class="records-entry-text">{{i18n.viewRecords}}</view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#a1a9b7" />
      </view>
    </view>
  </t-popup>

  <button class="share-fab" open-type="share" aria-label="{{i18n.shareApp}}">
    <t-icon name="share" size="52rpx" color="#ffffff" />
  </button>
</view>
