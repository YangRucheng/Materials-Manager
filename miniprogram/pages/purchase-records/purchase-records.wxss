.purchase-records-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-header { margin: 4rpx 4rpx 24rpx; }
.list-header .page-title { font-size: 44rpx; }

.list-tools {
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.filter-menu {
  margin-top: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  --td-dropdown-menu-height: 88rpx;
  --td-dropdown-menu-bg-color: #ffffff;
  --td-dropdown-menu-border-width: 0;
  --td-dropdown-menu-color: #4b5565;
  --td-dropdown-menu-active-color: #3f63d8;
}

.result-count { margin: 0 8rpx 14rpx; color: #7d8798; font-size: 23rpx; }
.record-list { display: flex; flex-direction: column; gap: 16rpx; }

.record-card {
  padding: 28rpx 28rpx 24rpx;
  border: 2rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.card-topline, .card-heading, .record-meta { display: flex; align-items: center; }
.card-topline { justify-content: flex-start; gap: 12rpx; margin-bottom: 14rpx; }
.plan-date { color: #8a94a5; font-size: 22rpx; }
.topline-right { margin-left: auto; }
.card-heading { margin-bottom: 6rpx; }
.material-name { flex: 1; min-width: 0; color: #172033; font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.material-spec { color: #7d8798; font-size: 24rpx; line-height: 1.45; word-break: break-all; padding-left: 2rpx; }
.trace-line { margin-top: 10rpx; color: #8a94a5; font-size: 22rpx; }
.card-divider { height: 2rpx; margin: 22rpx 0 18rpx; background: #f0f2f6; }
.meta-item { min-width: 190rpx; }
.responsible-item { flex: 1; }
.meta-label { color: #8a94a5; font-size: 21rpx; }
.quantity-value { margin-top: 4rpx; color: #2b4fc4; font-size: 31rpx; font-weight: 750; }
.meta-value { margin-top: 8rpx; color: #4b5565; font-size: 25rpx; font-weight: 550; }
.state-panel { display: flex; min-height: 420rpx; align-items: center; justify-content: center; }
.empty-panel { box-sizing: border-box; padding-top: 40rpx; }
.load-more, .load-finished { padding: 28rpx 0 8rpx; color: #a1a9b7; font-size: 22rpx; text-align: center; }

.back-top-fab {
  position: fixed;
  left: 32rpx;
  right: auto;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #3f63d8;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.35);
  line-height: 1;
}

.back-top-fab::after {
  border: 0;
}

.record-card-active {
  transform: scale(0.985);
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.08);
}

.detail-popup {
  box-sizing: border-box;
  width: 640rpx;
  max-height: 80vh;
  padding: 42rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  overflow-y: auto;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-all;
}

.detail-rows { display: flex; flex-direction: column; }

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f0f2f6;
}

.detail-row:last-child { border-bottom: 0; }

.detail-label {
  flex: none;
  width: 180rpx;
  color: #8a94a5;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.popup-divider { height: 2rpx; margin: 22rpx 0 18rpx; background: #f0f2f6; }

.image-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.image-section-title { color: #172033; font-size: 28rpx; font-weight: 650; }
.image-count { color: #687386; font-size: 24rpx; }

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.image-item {
  overflow: hidden;
  height: 192rpx;
  border-radius: 18rpx;
  background: #f4f6fa;
}

.record-image { display: block; width: 100%; height: 100%; }

.no-image {
  padding: 28rpx 0 8rpx;
  color: #7d8798;
  font-size: 26rpx;
  text-align: center;
}
