<view class="page-shell purchase-records-page">
  <view class="list-header"><view class="page-title">{{i18n.purchaseRecordsTitle}}</view></view>
  <view class="list-tools">
    <t-search
      value="{{keyword}}"
      placeholder="{{i18n.purchaseRecordSearchPlaceholder}}"
      shape="round"
      confirm-type="search"
      bind:change="onSearchChange"
    />
    <t-dropdown-menu class="filter-menu">
      <t-dropdown-item
        label="{{i18n.allPurchaseStatuses}}"
        value="{{status}}"
        options="{{statusOptions}}"
        bind:change="onStatusChange"
      />
      <t-dropdown-item
        label="{{i18n.allSubitemNos}}"
        value="{{subitemNo}}"
        options="{{subitemNoOptions}}"
        bind:change="onSubitemNoChange"
      />
    </t-dropdown-menu>
  </view>
  <view wx:if="{{!loading || items.length}}" class="result-count">{{resultCount}}</view>
  <view wx:if="{{loading && !items.length}}" class="state-panel">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingPurchaseRecords}}" />
  </view>
  <view wx:elif="{{!items.length}}" class="state-panel empty-panel">
    <t-empty icon="file" description="{{keyword || status ? i18n.purchaseRecordsEmptyFiltered : i18n.purchaseRecordsEmpty}}" />
  </view>
  <view wx:else class="record-list">
    <view
      wx:for="{{items}}"
      wx:key="line_id"
      class="record-card"
      hover-class="record-card-active"
      bind:tap="openDetail"
      data-index="{{index}}"
    >
      <view class="card-topline">
        <view class="plan-date">{{item.plan_date_label}}</view>
        <view class="topline-right">
          <t-tag theme="{{item.status_theme}}" variant="light" size="small">{{item.status}}</t-tag>
        </view>
      </view>
      <view class="card-heading">
        <view class="material-name">{{item.material_name}}</view>
      </view>
      <view class="material-spec">{{item.model_spec}}</view>
      <view wx:if="{{item.trace_no}}" class="trace-line">{{i18n.traceNo}}：{{item.trace_no}}</view>
      <view wx:if="{{item.subitem_no}}" class="trace-line">{{i18n.subitemNo}}：{{item.subitem_no}}</view>
      <view class="card-divider"></view>
      <view class="record-meta">
        <view class="meta-item">
          <view class="meta-label">{{i18n.purchaseQuantity}}</view>
          <view class="quantity-value">{{item.quantity_label}}</view>
        </view>
        <view class="meta-item responsible-item">
          <view class="meta-label">{{i18n.purchaseOrderNo}}</view>
          <view class="meta-value">{{item.purchase_order_no_label}}</view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="load-more">
    <t-loading theme="circular" size="36rpx" text="{{i18n.loadMore}}" />
  </view>
  <view wx:elif="{{items.length && !hasMore}}" class="load-finished">{{i18n.noMore}}</view>
  <t-toast id="purchase-records-toast" />
  <button
    wx:if="{{backTopVisible}}"
    class="back-top-fab"
    aria-label="{{i18n.backToTop}}"
    bind:tap="scrollToTop"
  >
    <t-icon name="backtop" size="52rpx" color="#ffffff" />
  </button>

  <t-popup
    visible="{{detailVisible}}"
    placement="center"
    close-btn
    close-on-overlay-click
    bind:visible-change="onDetailVisibleChange"
  >
    <view class="detail-popup" wx:if="{{detailItem}}">
      <view class="detail-title-row">
        <view class="detail-title">{{detailItem.material_name}}</view>
        <t-tag theme="{{detailItem.status_theme}}" variant="light" size="small">{{detailItem.status}}</t-tag>
      </view>
      <view class="detail-rows">
        <view class="detail-row"><view class="detail-label">{{i18n.modelSpec}}</view><view class="detail-value">{{detailItem.model_spec}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.materialCode}}</view><view class="detail-value">{{detailItem.material_code_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.category}}</view><view class="detail-value">{{detailItem.category_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.planNoLabel}}</view><view class="detail-value">{{detailItem.plan_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.planDate}}</view><view class="detail-value">{{detailItem.plan_date_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.purchaseQuantity}}</view><view class="detail-value">{{detailItem.quantity_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.purchaseOrderNo}}</view><view class="detail-value">{{detailItem.purchase_order_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.traceNo}}</view><view class="detail-value">{{detailItem.trace_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.subitemNo}}</view><view class="detail-value">{{detailItem.subitem_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.actualDemandPerson}}</view><view class="detail-value">{{detailItem.actual_demand_person_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.purchaseResponsible}}</view><view class="detail-value">{{detailItem.purchase_responsible_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.demandDepartment}}</view><view class="detail-value">{{detailItem.demand_department_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.usage}}</view><view class="detail-value">{{detailItem.usage_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.purchaseDateLabel}}</view><view class="detail-value">{{detailItem.purchase_date_label || i18n.notSet}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.salespersonLabel}}</view><view class="detail-value">{{detailItem.salesperson_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.remark}}</view><view class="detail-value">{{detailItem.remark_label}}</view></view>
      </view>
      <view class="popup-divider"></view>
      <view class="image-section">
        <view class="image-section-head">
          <view class="image-section-title">{{i18n.imageAttachments}}</view>
          <view class="image-count">{{detailItem.image_count_label}}</view>
        </view>
        <view wx:if="{{detailItem.images.length}}" class="image-grid">
          <view wx:for="{{detailItem.images}}" wx:key="id" class="image-item" data-index="{{index}}" bind:tap="previewImage">
            <image class="record-image" src="{{item.preview_url}}" mode="aspectFill" lazy-load webp />
          </view>
        </view>
        <view wx:else class="no-image">{{i18n.noImages}}</view>
      </view>
    </view>
  </t-popup>
</view>
