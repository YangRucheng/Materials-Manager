<view class="page-shell profile-page">
  <view class="page-title">首次使用</view>
  <view class="section-card">
    <t-cell-group>
      <t-input
        label="姓名"
        placeholder="请输入真实姓名"
        maxlength="64"
        value="{{displayName}}"
        bind:change="onNameChange"
      />
    </t-cell-group>
  </view>
  <t-button
    class="primary-action"
    theme="primary"
    size="large"
    block
    loading="{{loading}}"
    disabled="{{loading}}"
    bind:tap="submitProfile"
  >进入扫码出库</t-button>
  <t-toast id="profile-toast" />
</view>
