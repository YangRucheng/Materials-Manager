<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="detail-state">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingMaterialDetail}}" />
  </view>

  <view wx:elif="{{failed}}" class="detail-state failed-state">
    <t-empty icon="error-circle" description="{{i18n.materialDetailFailed}}" />
    <t-button theme="primary" variant="outline" size="small" bind:tap="retry">{{i18n.reload}}</t-button>
  </view>

  <block wx:elif="{{material}}">
    <material-summary-card material="{{material}}" />

    <view class="section-card detail-card">
      <view class="section-heading"><view class="section-title">{{i18n.materialInfo}}</view></view>
      <view class="section-divider"></view>
      <view class="remark-row">
        <view class="remark-label">{{i18n.remark}}</view>
        <view class="remark-value">{{material.remark || i18n.noRemark}}</view>
      </view>
    </view>

    <view class="section-card image-card">
      <view class="section-heading">
        <view class="section-title">{{i18n.imageAttachments}}</view>
        <view class="image-count">{{material.image_count_label}}</view>
      </view>
      <view class="section-divider"></view>
      <view wx:if="{{material.images.length}}" class="image-grid">
        <view
          wx:for="{{material.images}}"
          wx:key="id"
          class="image-item"
          data-index="{{index}}"
          bind:tap="previewImage"
        >
          <t-image
            src="{{item.preview_url}}"
            mode="aspectFill"
            shape="round"
            lazy
            webp
            width="100%"
            height="100%"
          />
        </view>
      </view>
      <view wx:else class="no-image">{{i18n.noImages}}</view>
    </view>
    <t-button
      class="outbound-entry"
      theme="primary"
      size="large"
      block
      icon="cart"
      bind:tap="goOutbound"
    >{{i18n.goOutbound}}</t-button>
  </block>

  <t-toast id="detail-toast" />
</view>
