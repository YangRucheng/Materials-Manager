.detail-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.detail-state {
  display: flex;
  min-height: 72vh;
  align-items: center;
  justify-content: center;
}

.failed-state {
  flex-direction: column;
  gap: 24rpx;
}

.detail-hero {
  margin-bottom: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #2947a6, #5579e7);
  box-shadow: 0 18rpx 44rpx rgba(41, 71, 166, 0.2);
  color: #ffffff;
}

.hero-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
}

.hero-spec {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.stock-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
}

.stock-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.stock-number {
  margin-top: 4rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stock-unit {
  padding-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  font-weight: 550;
}

.minimum-tip {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.4;
}

.detail-card {
  margin-bottom: 18rpx;
}

.detail-card .section-heading,
.image-card .section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
}

.detail-card .section-divider,
.image-card .section-divider {
  margin: 0 22rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 15rpx 22rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  flex: none;
  width: 132rpx;
  color: #687386;
  font-size: 28rpx;
  font-weight: 550;
  line-height: 1.45;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: #263044;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.remark-row .detail-value {
  color: #4b5565;
}

.image-count {
  color: #687386;
  font-size: 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 20rpx 22rpx;
}

.image-item {
  overflow: hidden;
  height: 192rpx;
  border-radius: 18rpx;
  background: #f4f6fa;
}

.no-image {
  padding: 32rpx 22rpx;
  color: #7d8798;
  font-size: 26rpx;
  text-align: center;
}

.outbound-entry {
  margin-top: 20rpx;
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-primary-active-bg-color: #3151bd;
  --td-button-primary-active-border-color: #3151bd;
  --td-button-border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.2);
}
