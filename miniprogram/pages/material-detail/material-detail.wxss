.detail-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.detail-state {
  display: flex;
  min-height: 72vh;
  align-items: center;
  justify-content: center;
}

.failed-state {
  flex-direction: column;
  gap: 24rpx;
}

.detail-card {
  margin-bottom: 18rpx;
}

.detail-card .section-heading,
.image-card .section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
}

.detail-card .section-divider,
.image-card .section-divider {
  margin: 0 22rpx;
}

.remark-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 22rpx 16rpx;
}

.remark-label {
  flex: none;
  width: 132rpx;
  color: #7d8798;
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.5;
}

.remark-value {
  flex: 1;
  min-width: 0;
  color: #687386;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.image-count {
  color: #687386;
  font-size: 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 20rpx 22rpx;
}

.image-item {
  overflow: hidden;
  height: 192rpx;
  border-radius: 18rpx;
  background: #f4f6fa;
}

.no-image {
  padding: 32rpx 22rpx;
  color: #7d8798;
  font-size: 26rpx;
  text-align: center;
}

.outbound-entry {
  margin-top: 20rpx;
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-primary-active-bg-color: #3151bd;
  --td-button-primary-active-border-color: #3151bd;
  --td-button-border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.2);
}
