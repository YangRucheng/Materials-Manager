<view class="page-shell record-detail-page">
  <view wx:if="{{loading}}" class="detail-state">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingPurchaseRecordDetail}}" />
  </view>
  <view wx:elif="{{failed}}" class="detail-state failed-state">
    <t-empty icon="error-circle" description="{{i18n.purchaseRecordDetailFailed}}" />
    <t-button theme="primary" variant="outline" size="small" bind:tap="retry">{{i18n.reload}}</t-button>
  </view>
  <block wx:elif="{{record}}">
    <view class="plan-summary-card">
      <view class="summary-heading">
        <view class="plan-name">{{record.material_name}}</view>
        <t-tag theme="{{record.status_theme}}" variant="light" size="small">{{record.status}}</t-tag>
      </view>
      <view class="plan-spec">{{record.model_spec}}</view>
      <view class="summary-footer">
        <view>
          <view class="summary-label">{{i18n.planDate}}</view>
          <view class="summary-date">{{record.plan_date_label}}</view>
        </view>
        <view class="quantity-block">
          <view class="summary-label">{{i18n.purchaseQuantity}}</view>
          <view class="quantity-value">{{record.quantity_label}}</view>
        </view>
      </view>
    </view>

    <view class="section-card detail-card">
      <view class="section-heading"><view class="section-title">{{i18n.purchaseRecordInfo}}</view></view>
      <view class="section-divider"></view>
      <view class="detail-list">
        <view class="detail-row">
          <view class="detail-label">{{i18n.materialCode}}</view>
          <view wx:if="{{record.material_code_copyable}}" class="detail-value copy-value" data-code="{{record.material_code}}" bind:tap="copyMaterialCode">{{record.material_code_label}}</view>
          <view wx:else class="detail-value">{{record.material_code_label}}</view>
        </view>
        <view class="detail-row"><view class="detail-label">{{i18n.purchaseDateLabel}}</view><view class="detail-value">{{record.purchase_date_label || i18n.notSet}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.purchaseOrderNo}}</view><view class="detail-value">{{record.purchase_order_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.traceNo}}</view><view class="detail-value">{{record.trace_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.actualDemandPerson}}</view><view class="detail-value">{{record.actual_demand_person_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.demandDepartment}}</view><view class="detail-value">{{record.demand_department_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.subitemNo}}</view><view class="detail-value">{{record.subitem_no_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.usage}}</view><view class="detail-value">{{record.usage_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.salespersonLabel}}</view><view class="detail-value">{{record.salesperson_label}}</view></view>
        <view class="detail-row"><view class="detail-label">{{i18n.remark}}</view><view class="detail-value">{{record.remark_label}}</view></view>
      </view>
    </view>

    <view class="section-card image-card">
      <view class="section-heading">
        <view class="section-title">{{i18n.imageAttachments}}</view>
        <view class="image-count">{{record.image_count_label}}</view>
      </view>
      <view class="section-divider"></view>
      <view wx:if="{{record.images.length}}" class="image-grid">
        <view wx:for="{{record.images}}" wx:key="id" class="image-item" data-index="{{index}}" bind:tap="previewImage">
          <image class="plan-image" src="{{item.preview_url}}" mode="aspectFill" lazy-load webp />
        </view>
      </view>
      <view wx:else class="no-image">{{i18n.noImages}}</view>
    </view>
  </block>
  <t-toast id="purchase-record-detail-toast" />
</view>
