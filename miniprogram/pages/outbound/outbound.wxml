<view class="page-shell outbound-page">
  <view wx:if="{{loading}}" class="section-card loading-card">
    <t-loading theme="circular" size="48rpx" text="{{i18n.loadingMaterial}}" />
  </view>

  <material-summary-card wx:if="{{material}}" material="{{material}}" />

  <view wx:if="{{material}}" class="section-card form-card">
    <view class="section-heading">
      <view class="section-title">{{i18n.outboundInfo}}</view>
    </view>
    <view class="section-divider"></view>
    <t-cell-group>
      <t-input
        label="{{i18n.outboundQuantity}}"
        type="digit"
        placeholder="{{i18n.inputPlaceholder}}"
        suffix="{{material.unit_name}}"
        value="{{form.quantity}}"
        data-field="quantity"
        bind:change="onFieldChange"
      />
      <t-input
        label="{{i18n.subitemNo}}"
        placeholder="{{i18n.inputPlaceholder}}"
        maxlength="64"
        value="{{form.subitemNo}}"
        data-field="subitemNo"
        bind:change="onFieldChange"
      />
      <t-input
        label="{{i18n.outboundPurpose}}"
        placeholder="{{i18n.inputPlaceholder}}"
        maxlength="500"
        value="{{form.businessReason}}"
        data-field="businessReason"
        bind:change="onFieldChange"
      />
      <view wx:if="{{recentReasons.length}}" class="reason-shortcuts">
        <view class="reason-label">{{i18n.recentReasons}}</view>
        <scroll-view class="reason-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="reason-tags">
            <t-tag
              wx:for="{{recentReasons}}"
              wx:key="key"
              theme="primary"
              variant="light"
              size="small"
              max-width="360rpx"
              data-reason="{{item.reason}}"
              data-subitem-no="{{item.subitemNo}}"
              bind:click="selectReason"
            >{{item.display}}</t-tag>
          </view>
        </scroll-view>
      </view>
    </t-cell-group>
  </view>

  <view wx:if="{{material}}" class="outbound-actions">
    <t-button
      class="outbound-action rescan-action"
      theme="default"
      variant="outline"
      size="large"
      icon="scan"
      loading="{{scanning}}"
      disabled="{{scanning || submitting}}"
      bind:tap="scanMaterial"
    >{{i18n.rescan}}</t-button>
    <t-button
      class="outbound-action confirm-action"
      theme="primary"
      size="large"
      icon="check-circle"
      loading="{{submitting}}"
      disabled="{{submitting || scanning}}"
      bind:tap="submitOutbound"
    >{{i18n.confirmOutbound}}</t-button>
  </view>

  <t-toast id="outbound-toast" />
</view>
