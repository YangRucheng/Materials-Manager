<view class="page-shell outbound-page">
  <view class="page-header">
    <view class="header-row">
      <view>
        <view class="page-eyebrow">WAREHOUSE OUTBOUND</view>
        <view class="page-title">扫码出库</view>
      </view>
      <view class="operator-badge" hover-class="operator-badge-active" bind:tap="showUserProfile">
        <view class="operator-dot"></view>
        <view class="operator-name">{{user.display_name}}</view>
        <t-icon name="chevron-down" size="24rpx" color="#5573d1" />
      </view>
    </view>
  </view>

  <view
    wx:if="{{!material}}"
    class="inventory-entry-card"
    hover-class="inventory-entry-card-active"
    bind:tap="openInventory"
  >
    <view class="inventory-entry-icon"><t-icon name="view-list" size="44rpx" /></view>
    <view class="inventory-entry-content">
      <view class="inventory-entry-title">查看全库库存</view>
      <view class="inventory-entry-description">搜索、筛选并查看物资详情</view>
    </view>
    <view class="inventory-entry-arrow"><t-icon name="chevron-right" size="36rpx" /></view>
  </view>

  <view wx:if="{{!material}}" class="section-card scan-card">
    <view class="scan-card-heading">
      <view class="scan-kicker">第一步</view>
      <view class="scan-title">扫描物资小程序码</view>
    </view>
    <t-button
      class="scan-action"
      theme="primary"
      size="large"
      block
      loading="{{scanning}}"
      disabled="{{scanning || submitting}}"
      icon="scan"
      bind:tap="scanMaterial"
    >{{material ? '重新扫码' : '扫描物资小程序码'}}</t-button>
  </view>

  <view wx:if="{{material}}" class="section-card material-card">
    <view class="section-heading material-heading">
      <view class="section-title">物资信息</view>
    </view>
    <view class="material-summary">
      <view class="material-main">
        <view class="material-name">{{material.name}}</view>
        <view class="material-spec">{{material.model_spec}}</view>
      </view>
      <view class="stock-summary">
        <view class="stock-label">当前库存</view>
        <view class="stock-value">{{material.current_qty}} {{material.unit_name}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{material}}" class="section-card form-card">
    <view class="section-heading">
      <view class="section-title">出库信息</view>
    </view>
    <view class="section-divider"></view>
    <t-cell-group>
      <t-input
        label="出库数量"
        type="digit"
        placeholder="请输入"
        suffix="{{material.unit_name}}"
        value="{{form.quantity}}"
        data-field="quantity"
        bind:change="onFieldChange"
      />
      <t-input
        label="子项号"
        placeholder="请输入"
        maxlength="64"
        value="{{form.subitemNo}}"
        data-field="subitemNo"
        bind:change="onFieldChange"
      />
      <t-input
        label="出库用途"
        placeholder="请输入"
        maxlength="500"
        value="{{form.businessReason}}"
        data-field="businessReason"
        bind:change="onFieldChange"
      />
      <view wx:if="{{recentReasons.length}}" class="reason-shortcuts">
        <view class="reason-label">一键采用近期出库用途</view>
        <scroll-view class="reason-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="reason-tags">
            <t-tag
              wx:for="{{recentReasons}}"
              wx:key="*this"
              theme="primary"
              variant="light"
              size="small"
              max-width="300rpx"
              data-reason="{{item}}"
              bind:click="selectReason"
            >{{item}}</t-tag>
          </view>
        </scroll-view>
      </view>
    </t-cell-group>
  </view>

  <view wx:if="{{material}}" class="outbound-actions">
    <t-button
      class="outbound-action rescan-action"
      theme="default"
      variant="outline"
      size="large"
      icon="scan"
      loading="{{scanning}}"
      disabled="{{scanning || submitting}}"
      bind:tap="scanMaterial"
    >重新扫码</t-button>
    <t-button
      class="outbound-action confirm-action"
      theme="primary"
      size="large"
      icon="check-circle"
      loading="{{submitting}}"
      disabled="{{submitting || scanning}}"
      bind:tap="submitOutbound"
    >确认出库</t-button>
  </view>

  <t-toast id="outbound-toast" />
  <t-popup
    visible="{{userProfileVisible}}"
    placement="center"
    close-btn
    close-on-overlay-click
    bind:visible-change="onUserProfileVisibleChange"
  >
    <view class="user-profile-popup">
      <view class="user-profile-avatar"><t-icon name="user" size="48rpx" /></view>
      <view class="user-profile-title">个人信息</view>
      <view class="user-profile-list">
        <view class="user-profile-row">
          <view class="user-profile-label">姓名</view>
          <view class="user-profile-value">{{user.display_name}}</view>
        </view>
        <view class="user-profile-row">
          <view class="user-profile-label">部门单位</view>
          <view class="user-profile-value">{{user.department_name}}</view>
        </view>
        <view class="user-profile-row">
          <view class="user-profile-label">注册时间</view>
          <view class="user-profile-value">{{user.registered_at}}</view>
        </view>
      </view>
    </view>
  </t-popup>
</view>
