<view class="page-shell outbound-page">
  <view class="page-header">
    <view class="header-row">
      <view>
        <view class="page-eyebrow">WAREHOUSE OUTBOUND</view>
        <view class="page-title">扫码出库</view>
      </view>
      <view class="operator-badge">
        <view class="operator-dot"></view>
        <view class="operator-name">{{user.display_name}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!material}}" class="section-card scan-card">
    <view class="scan-card-heading">
      <view class="scan-kicker">第一步</view>
      <view class="scan-title">扫描物资小程序码</view>
    </view>
    <t-button
      class="scan-action"
      theme="primary"
      size="large"
      block
      loading="{{scanning}}"
      disabled="{{scanning || submitting}}"
      icon="scan"
      bind:tap="scanMaterial"
    >{{material ? '重新扫码' : '扫描物资小程序码'}}</t-button>
  </view>

  <view wx:if="{{material}}" class="section-card material-card">
    <view class="section-heading material-heading">
      <view class="section-title">物资信息</view>
      <t-button
        class="rescan-action"
        theme="primary"
        variant="text"
        size="small"
        icon="scan"
        loading="{{scanning}}"
        disabled="{{scanning || submitting}}"
        bind:tap="scanMaterial"
      >重新扫码</t-button>
    </view>
    <view class="material-summary">
      <view class="material-main">
        <view class="material-name">{{material.name}}</view>
        <view class="material-spec">{{material.model_spec}}</view>
      </view>
      <view class="stock-summary">
        <view class="stock-label">当前库存</view>
        <view class="stock-value">{{material.current_qty}} {{material.unit_name}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{material}}" class="section-card form-card">
    <view class="section-heading">
      <view class="section-title">出库信息</view>
    </view>
    <view class="section-divider"></view>
    <t-cell-group>
      <t-input
        label="出库数量"
        type="digit"
        placeholder="请输入"
        suffix="{{material.unit_name}}"
        value="{{form.quantity}}"
        data-field="quantity"
        bind:change="onFieldChange"
      />
      <t-input
        label="出库用途"
        placeholder="请输入"
        maxlength="500"
        value="{{form.businessReason}}"
        data-field="businessReason"
        bind:change="onFieldChange"
      />
      <view wx:if="{{personalReasons.length || systemReasons.length}}" class="reason-shortcuts">
        <view wx:if="{{personalReasons.length}}" class="reason-group">
          <view class="reason-label">我的最近用途</view>
          <scroll-view class="reason-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="reason-tags">
              <t-tag
                wx:for="{{personalReasons}}"
                wx:key="*this"
                theme="primary"
                variant="light"
                size="small"
                max-width="300rpx"
                data-reason="{{item}}"
                bind:click="selectReason"
              >{{item}}</t-tag>
            </view>
          </scroll-view>
        </view>
        <view wx:if="{{systemReasons.length}}" class="reason-group">
          <view class="reason-label">全员最近用途</view>
          <scroll-view class="reason-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="reason-tags">
              <t-tag
                wx:for="{{systemReasons}}"
                wx:key="*this"
                theme="default"
                variant="light"
                size="small"
                max-width="300rpx"
                data-reason="{{item}}"
                bind:click="selectReason"
              >{{item}}</t-tag>
            </view>
          </scroll-view>
        </view>
      </view>
      <t-input
        label="子项号"
        placeholder="请输入"
        maxlength="64"
        value="{{form.subitemNo}}"
        data-field="subitemNo"
        bind:change="onFieldChange"
      />
    </t-cell-group>
  </view>

  <t-button
    wx:if="{{material}}"
    class="primary-action"
    theme="primary"
    size="large"
    block
    loading="{{submitting}}"
    disabled="{{submitting || scanning}}"
    bind:tap="submitOutbound"
  >确认出库</t-button>

  <t-toast id="outbound-toast" />
</view>
