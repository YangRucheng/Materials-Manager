.outbound-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 250rpx;
  margin-top: 8rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid #dce5ff;
  border-radius: 999rpx;
  background: #edf2ff;
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #229b6b;
  box-shadow: 0 0 0 6rpx rgba(34, 155, 107, 0.12);
}

.operator-name {
  overflow: hidden;
  color: #3658c7;
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scan-card {
  padding: 32rpx;
  border-color: #dce5ff;
  background: linear-gradient(145deg, #ffffff 0%, #f8faff 100%);
}

.scan-card-heading {
  margin-bottom: 28rpx;
}

.scan-kicker {
  color: #3f63d8;
  font-size: 22rpx;
  font-weight: 600;
}

.scan-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.scan-description {
  margin-top: 6rpx;
  color: #7d8798;
  font-size: 24rpx;
  line-height: 1.5;
}

.scan-action {
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-primary-active-bg-color: #3151bd;
  --td-button-primary-active-border-color: #3151bd;
  --td-button-border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.18);
}

.scan-button-text {
  margin-left: 12rpx;
}

.material-card {
  border-color: #dce5ff;
}

.material-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.status-badge {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(34, 155, 107, 0.1);
  color: #198057;
  font-size: 22rpx;
  font-weight: 600;
}

.form-card {
  --td-input-bg-color: #ffffff;
}

.submit-tip {
  margin: 20rpx 28rpx 0;
  color: #7d8798;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
