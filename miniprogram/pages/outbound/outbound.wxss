.outbound-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading-card {
  display: flex;
  min-height: 240rpx;
  align-items: center;
  justify-content: center;
}

.page-header {
  margin: 4rpx 4rpx 20rpx;
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.operator-badge {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
  max-width: 280rpx;
  margin-top: 4rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid #dce5ff;
  border-radius: 999rpx;
  background: #edf2ff;
  transition: transform 120ms ease, background 120ms ease;
}

.operator-badge-active {
  transform: scale(0.97);
  background: #e3eaff;
}

.operator-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #229b6b;
  box-shadow: 0 0 0 6rpx rgba(34, 155, 107, 0.12);
}

.operator-name {
  overflow: hidden;
  color: #3658c7;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inventory-entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #dce5ff;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f8faff 0%, #edf2ff 100%);
  box-shadow: 0 10rpx 28rpx rgba(63, 99, 216, 0.08);
  transition: transform 120ms ease, background 120ms ease;
}

.inventory-entry-card-active {
  transform: scale(0.99);
  background: #e9efff;
}

.inventory-entry-icon {
  display: flex;
  flex: none;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #3f63d8;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(63, 99, 216, 0.22);
}

.inventory-entry-content {
  flex: 1;
  min-width: 0;
}

.inventory-entry-title {
  color: #243765;
  font-size: 28rpx;
  font-weight: 650;
}

.inventory-entry-description {
  margin-top: 6rpx;
  color: #7180a5;
  font-size: 22rpx;
}

.inventory-entry-arrow {
  display: flex;
  color: #6c83cf;
}

.user-profile-popup {
  box-sizing: border-box;
  width: 620rpx;
  padding: 42rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.user-profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  background: #edf2ff;
  color: #3f63d8;
}

.user-profile-title {
  margin: 18rpx 0 26rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}

.user-profile-list {
  padding: 4rpx 22rpx;
  border-radius: 20rpx;
  background: #f8faff;
}

.user-profile-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #e9edf5;
}

.user-profile-row:last-child {
  border-bottom: 0;
}

.user-profile-label {
  flex: none;
  width: 120rpx;
  color: #8a94a5;
  font-size: 23rpx;
}

.user-profile-value {
  flex: 1;
  min-width: 0;
  color: #30394a;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.scan-card {
  padding: 32rpx;
  border-color: #dce5ff;
  background: linear-gradient(145deg, #ffffff 0%, #f8faff 100%);
}

.scan-card-heading {
  margin-bottom: 28rpx;
}

.scan-kicker {
  color: #3f63d8;
  font-size: 22rpx;
  font-weight: 600;
}

.scan-title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.scan-action {
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-primary-active-bg-color: #3151bd;
  --td-button-primary-active-border-color: #3151bd;
  --td-button-border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 99, 216, 0.18);
}

.form-card {
  --td-input-bg-color: #ffffff;
  --td-input-vertical-padding: 20rpx 24rpx;
  --td-input-label-text-font: 28rpx / 42rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  --td-input-placeholder-text-font: 28rpx / 42rpx -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.form-card .section-heading {
  padding: 20rpx 24rpx 14rpx;
}

.form-card .section-divider {
  margin: 0 24rpx;
}

.reason-shortcuts {
  padding: 12rpx 24rpx 14rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.reason-label {
  margin-bottom: 8rpx;
  color: #7d8798;
  font-size: 21rpx;
  line-height: 1.3;
}

.reason-scroll {
  width: 100%;
  white-space: nowrap;
}

.reason-tags {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 24rpx;
}

.outbound-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.outbound-action {
  flex: 1;
  min-width: 0;
}

.confirm-action {
  --td-button-primary-bg-color: #3f63d8;
  --td-button-primary-border-color: #3f63d8;
  --td-button-primary-active-bg-color: #3151bd;
  --td-button-primary-active-border-color: #3151bd;
}
