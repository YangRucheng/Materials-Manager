.purchase-plans-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.list-header { margin: 4rpx 4rpx 24rpx; }
.list-header .page-title { font-size: 44rpx; }

.list-tools {
  margin-bottom: 20rpx;
  padding: 4rpx 0;
}

.filter-menu {
  margin-top: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  --td-dropdown-menu-height: 88rpx;
  --td-dropdown-menu-bg-color: #ffffff;
  --td-dropdown-menu-border-width: 0;
  --td-dropdown-menu-color: #4b5565;
  --td-dropdown-menu-active-color: #3f63d8;
}

.result-count { margin: 0 8rpx 14rpx; color: #7d8798; font-size: 23rpx; }
.plan-list { display: flex; flex-direction: column; gap: 16rpx; }

.plan-card {
  padding: 28rpx 28rpx 24rpx;
  border: 2rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.plan-card-active { transform: scale(0.99); box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.08); }
.card-topline, .card-heading, .plan-meta { display: flex; align-items: center; }
.card-topline { justify-content: flex-start; gap: 12rpx; margin-bottom: 14rpx; }
.plan-date { color: #8a94a5; font-size: 22rpx; }
.topline-right { margin-left: auto; }
.card-heading { margin-bottom: 6rpx; }
.material-name { flex: 1; min-width: 0; color: #172033; font-size: 30rpx; font-weight: 700; line-height: 1.4; }
.material-spec { color: #7d8798; font-size: 24rpx; line-height: 1.45; word-break: break-all; padding-left: 2rpx; }
.card-divider { height: 2rpx; margin: 22rpx 0 18rpx; background: #f0f2f6; }
.meta-item { min-width: 190rpx; }
.responsible-item { flex: 1; }
.meta-label { color: #8a94a5; font-size: 21rpx; }
.quantity-value { margin-top: 4rpx; color: #2b4fc4; font-size: 31rpx; font-weight: 750; }
.meta-value { margin-top: 8rpx; color: #4b5565; font-size: 25rpx; font-weight: 550; }
.state-panel { display: flex; min-height: 420rpx; align-items: center; justify-content: center; }
.empty-panel { box-sizing: border-box; padding-top: 40rpx; }
.load-more, .load-finished { padding: 28rpx 0 8rpx; color: #a1a9b7; font-size: 22rpx; text-align: center; }
