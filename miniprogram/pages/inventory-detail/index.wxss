.detail-page {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.detail-state {
  display: flex;
  min-height: 72vh;
  align-items: center;
  justify-content: center;
}

.failed-state {
  flex-direction: column;
  gap: 24rpx;
}

.detail-hero {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #2947a6, #5579e7);
  box-shadow: 0 18rpx 44rpx rgba(41, 71, 166, 0.2);
  color: #ffffff;
}

.hero-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.hero-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
}

.hero-spec {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.stock-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
}

.stock-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
}

.stock-number {
  margin-top: 4rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stock-unit {
  padding-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  font-weight: 550;
}

.minimum-tip {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.detail-card .section-heading,
.image-card .section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.detail-card .section-divider,
.image-card .section-divider {
  margin: 0 24rpx;
}

.detail-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 24rpx;
  border-bottom: 2rpx solid #edf0f5;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-label {
  flex: none;
  width: 128rpx;
  color: #8a94a5;
  font-size: 24rpx;
}

.detail-value {
  flex: 1;
  min-width: 0;
  color: #30394a;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: right;
  word-break: break-all;
}

.remark-row .detail-value {
  color: #687386;
}

.image-count {
  color: #8a94a5;
  font-size: 22rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 24rpx;
}

.image-item {
  overflow: hidden;
  height: 192rpx;
  border-radius: 18rpx;
  background: #f4f6fa;
}

.no-image {
  padding: 52rpx 24rpx;
  color: #a1a9b7;
  font-size: 24rpx;
  text-align: center;
}
