.material-summary-card {
  margin-bottom: 18rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #2947a6, #5579e7);
  box-shadow: 0 18rpx 44rpx rgba(41, 71, 166, 0.2);
  color: #ffffff;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.material-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.4;
  word-break: break-all;
}

.material-spec {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-all;
}

.stock-block {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
}

.stock-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.stock-number {
  margin-top: 4rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stock-unit {
  padding-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  font-weight: 550;
}

.minimum-tip {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.4;
}
