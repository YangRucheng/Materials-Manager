page {
  min-height: 100%;
  background: #f3f5f8;
  color: #1d2129;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.page-title {
  margin: 8rpx 0 28rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.section-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
}

.primary-action {
  margin-top: 32rpx;
}
